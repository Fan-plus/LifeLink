<resources>
    <!-- Base application theme. -->
    <style name="Theme.LifeLink" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/eye_friendly_accent</item>
        <item name="colorPrimaryVariant">@color/eye_friendly_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/eye_friendly_text</item>
        <item name="colorSecondaryVariant">@color/eye_friendly_text</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- App default button style -->
    <style name="App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!-- 圆形图片的 ShapeAppearance -->
    <style name="CircleImage" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>
    
    <!-- 别名，兼容之前的引用 -->
    <style name="CircleImageStyle" parent="CircleImage" />

</resources>