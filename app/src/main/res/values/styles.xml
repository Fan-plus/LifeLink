<resources>
    <!-- Base application theme. -->
    <style name="Theme.LifeLink" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/eye_friendly_accent</item>
        <item name="colorPrimaryVariant">@color/eye_friendly_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/eye_friendly_text</item>
        <item name="colorSecondaryVariant">@color/eye_friendly_text</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>