<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/companion_soft_blue"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_main"
                app:tint="@color/memory_deep_blue"
                android:contentDescription="陪伴图标" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/memory_deep_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/memory_text_secondary"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 虚拟孙辈 区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/avatar_placeholder"
                android:contentDescription="虚拟孙辈头像" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可爱小孙孙 · 暖心陪伴模式"
                android:textColor="@color/eye_friendly_text"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_voice_chat"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/companion_voice_chat"
                    app:cornerRadius="22dp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/companion_button_blue"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_reminder"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/companion_set_reminder"
                    app:cornerRadius="22dp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/memory_health_green"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 声音选择 / 上传音色 入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_companion_card">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/companion_button_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_voice_select_title"
                        android:textColor="@color/eye_friendly_text"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_current_voice"
                        android:textColor="@color/memory_text_secondary"
                        android:textSize="12sp"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/companion_change_voice"
                    android:textColor="@color/white"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/companion_button_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_upload_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/companion_upload_voice"
                    android:textColor="@color/white"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/memory_light_blue" />
            </LinearLayout>

            <!-- 快捷功能卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_companion_card"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_medicine"
                        app:tint="@color/memory_deep_blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_quick_med"
                        android:textColor="@color/eye_friendly_text"
                        android:paddingTop="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_companion_card"
                    android:padding="10dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/memory_deep_blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_quick_story"
                        android:textColor="@color/eye_friendly_text"
                        android:paddingTop="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_companion_card"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_main"
                        app:tint="@color/memory_deep_blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_quick_chat"
                        android:textColor="@color/eye_friendly_text"
                        android:paddingTop="8dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 语音交互中心 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/companion_voice_prompt"
                android:textColor="@color/memory_text_secondary"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_rounded_light">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/companion_button_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_hold_to_talk"
                    android:textColor="@color/eye_friendly_text"
                    android:paddingTop="10dp"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_press_to_talk"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/companion_hold_to_talk"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/companion_button_blue"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>