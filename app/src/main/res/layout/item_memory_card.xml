<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/memory_card_root"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/memory_card_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp"
            android:paddingEnd="32dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/memory_card_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_medicine"
                app:tint="@color/memory_light_blue"
                android:contentDescription="记忆图标" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/memory_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="标题"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/memory_deep_blue" />

                <TextView
                    android:id="@+id/memory_card_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="备注"
                    android:textSize="11sp"
                    android:textColor="@color/memory_text_secondary"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/memory_card_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:padding="7dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/close"
            app:tint="@color/memory_text_secondary"
            android:contentDescription="删除记忆" />
    </FrameLayout>

</androidx.cardview.widget.CardView>
