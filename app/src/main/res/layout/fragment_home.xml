<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layoutAnimation="@anim/layout_animation_fall_down">

        <!-- 顶部欢迎语 -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LifeLink 守护"
                android:textSize="14sp"
                android:textColor="@color/eye_friendly_accent"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="您好，今天状态不错"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 健康卡片滑屏区 -->
        <HorizontalScrollView
            android:id="@+id/health_cards_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/header_layout">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <!-- 实时健康 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_health_status"
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_heart_rate"
                            app:tint="#FF5252" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="心率"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/heart_rate_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72 bpm"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/watch_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已连接手表"
                            android:textSize="11sp"
                            android:textColor="#4CAF50" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 定位状态 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_main"
                            app:tint="#2196F3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="位置"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/location_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="安全区域"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 每日打卡 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#4CAF50" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="今日已打卡"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50"
                            android:layout_marginTop="8dp" />
                        <Button
                            android:id="@+id/refresh_checkin_button"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="16dp"
                            android:text="重新打卡"
                            android:textSize="11sp"
                            app:cornerRadius="18dp"
                            android:backgroundTint="#F5F5F5"
                            android:textColor="#666666"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 用药提醒 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/medicine_reminder_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/health_cards_layout" />

        <!-- AI 语音大卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ai_voice_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/medicine_reminder_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="有什么我可以帮您的？"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voice_search_button"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="20dp"
                    android:text="按住说话"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/eye_friendly_accent"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_mic"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:elevation="4dp" />

                <!-- 波纹动画点 -->
                <LinearLayout
                    android:id="@+id/voice_wave_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">
                    <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot4" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot5" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                </LinearLayout>

                <!-- 识别结果区 -->
                <LinearLayout
                    android:id="@+id/voice_result_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:background="#F8F9FA"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/voice_result_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/eye_friendly_accent" />
                    <TextView
                        android:id="@+id/voice_result_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 常用功能网格 -->
        <GridLayout
            android:id="@+id/quick_functions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:columnCount="3"
            app:layout_constraintTop_toBottomOf="@+id/ai_voice_layout">

            <!-- 药品识别 -->
            <LinearLayout
                android:id="@+id/btn_medicine_identify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#E8F5E9" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_medicine" app:tint="#2E7D32" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="药品识别" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 异常预警 -->
            <LinearLayout
                android:id="@+id/btn_abnormal_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#FFEBEE" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_alert" app:tint="#D32F2F" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="异常预警" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 联系子女 -->
            <LinearLayout
                android:id="@+id/btn_contact_children"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#E3F2FD" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_family" app:tint="#1976D2" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="联系子女" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 暖心陪伴 -->
            <LinearLayout
                android:id="@+id/btn_warm_companion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#FDF2F2" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_heart" app:tint="#F06292" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暖心陪伴" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 我的回忆 -->
            <LinearLayout
                android:id="@+id/btn_my_memories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#FFF8E1" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_book" app:tint="#FFB300" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的回忆" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 保险箱 -->
            <LinearLayout
                android:id="@+id/btn_will_safe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#EDE7F6" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_safe" app:tint="#7B1FA2" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保险箱" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>