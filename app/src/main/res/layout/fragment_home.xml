<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layoutAnimation="@anim/layout_animation_fall_down">

        <!-- 1. 顶部欢迎语与账号悬浮按钮 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_account_toggle"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LifeLink 守护"
                    android:textSize="14sp"
                    android:textColor="@color/eye_friendly_accent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="您好，今天状态不错"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_account_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_account_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_family"
                    app:tint="@color/eye_friendly_accent" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 云端账户与同步 - 精致紧凑版 (修复闪退) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_account_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EEF0F5"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/header_layout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="云端账户与家庭"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <ImageButton
                        android:id="@+id/btn_close_account"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#CCCCCC" />
                </RelativeLayout>

                <!-- 1. 未登录态 -->
                <LinearLayout
                    android:id="@+id/layout_auth_inputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="用户名"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="密码"
                        app:passwordToggleEnabled="true"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">
                        <Button
                            android:id="@+id/btn_register"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="新用户"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="16dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        <Button
                            android:id="@+id/btn_login"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="登录"
                            android:textSize="13sp"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. 已登录态 (同步成功后) -->
                <LinearLayout
                    android:id="@+id/layout_account_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/ov_circle"
                            android:backgroundTint="#4CAF50" />
                        <TextView
                            android:id="@+id/tv_logged_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="已连接: testuser"
                            android:textColor="#666666"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 绑定码区域 (修复后的类型兼容版) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bind_code"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/bind_code_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="家庭绑定码"
                            android:textSize="11sp"
                            android:textColor="#999999"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_bind_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="------"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/eye_friendly_accent"
                            android:letterSpacing="0.1"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/bind_code_label"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_gen_bind_code"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="0dp"
                            app:icon="@android:drawable/stat_notify_sync"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/eye_friendly_accent"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <Button
                        android:id="@+id/btn_logout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="切换账号 / 退出"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 健康卡片滑屏区 -->
        <HorizontalScrollView
            android:id="@+id/health_cards_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/card_account_sync">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <!-- 实时健康 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_health_status"
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_heart_rate"
                            app:tint="#FF5252" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="心率"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/heart_rate_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72 bpm"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/watch_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已连接手表"
                            android:textSize="11sp"
                            android:textColor="#4CAF50" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 定位状态 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_main"
                            app:tint="#2196F3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="位置"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/location_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="安全区域"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 每日打卡 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="160dp"
                    android:layout_height="190dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#4CAF50" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="今日已打卡"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50"
                            android:layout_marginTop="8dp" />
                        <Button
                            android:id="@+id/refresh_checkin_button"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="16dp"
                            android:text="重新打卡"
                            android:textSize="11sp"
                            app:cornerRadius="18dp"
                            android:backgroundTint="#F5F5F5"
                            android:textColor="#666666"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 3. AI 语音交互区 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ai_voice_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/health_cards_layout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="有什么我可以帮您的？"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voice_search_button"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="20dp"
                    android:text="按住说话"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/eye_friendly_accent"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_mic"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:elevation="4dp" />

                <!-- 波纹动画点 -->
                <LinearLayout
                    android:id="@+id/voice_wave_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">
                    <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot4" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                    <View android:id="@+id/dot5" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/ov_circle" android:layout_margin="4dp" />
                </LinearLayout>

                <!-- 识别结果区 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/voice_result_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEEEEE"
                    app:cardBackgroundColor="#F8F9FA"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:id="@+id/voice_result_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_alignParentStart="true">
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="16dp"
                                    android:background="@color/eye_friendly_accent" />
                                <TextView
                                    android:id="@+id/voice_result_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="识别结果"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/eye_friendly_accent" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_alignParentEnd="true">
                                <TextView
                                    android:id="@+id/expand_text_hint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="查看详情"
                                    android:textSize="12sp"
                                    android:textColor="#999999" />
                                <ImageView
                                    android:id="@+id/voice_result_expand_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@android:drawable/arrow_down_float"
                                    app:tint="#999999" />
                            </LinearLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/voice_result_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#EEEEEE"
                                android:layout_marginBottom="12dp" />

                            <TextView
                                android:id="@+id/voice_result_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. 提醒列表区 -->
        <LinearLayout
            android:id="@+id/reminder_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/ai_voice_layout">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待办提醒"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <ImageButton
                    android:id="@+id/btn_refresh_reminders"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/stat_notify_sync"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    app:tint="@color/eye_friendly_accent"
                    android:contentDescription="刷新列表" />
            </RelativeLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reminder_container_card"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E6ED"
                app:cardBackgroundColor="@color/white">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/medicine_reminder_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 5. 常用功能网格 -->
        <GridLayout
            android:id="@+id/quick_functions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:columnCount="3"
            app:layout_constraintTop_toBottomOf="@+id/reminder_section">

            <!-- 药品识别 -->
            <LinearLayout
                android:id="@+id/btn_medicine_identify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground">
                <View android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/ov_circle" android:backgroundTint="#E8F5E9" />
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginTop="-40dp" android:src="@drawable/ic_medicine" app:tint="#2E7D32" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="药品识别" android:textSize="12sp" android:layout_marginTop="24dp" android:textColor="#555555" />
            </LinearLayout>

            <!-- 异常预警 -->
            <LinearLayout
                android:id="@+id/btn_abnormal_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
