<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2">

    <!-- 顶部装饰 - 柔和的渐变或线条感 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/memory_bottom_fade"
        android:rotation="180"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 返回按钮 - 移除背景，使用更简洁的图标 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="20dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:src="@drawable/close"
        app:tint="#A68E74"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="岁月留痕"
        android:textSize="16sp"
        android:textColor="#A68E74"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 回忆录正文区域 - 更加书卷气的排版 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toTopOf="@id/btn_re_generate">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="20dp"
            android:paddingBottom="60dp">

            <!-- 装饰性元素：一朵小花或淡色图标 -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                android:alpha="0.3"
                app:tint="#C5A377"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/tv_memoir_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5D4037"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="40dp" />

            <TextView
                android:id="@+id/tv_memoir_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="14dp"
                android:textSize="19sp"
                android:textColor="#4E342E"
                android:fontFamily="serif"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="60dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:background="#D9C9B4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 加载状态覆盖层 -->
    <LinearLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#FAF7F2"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#C5A377" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在为您拾起岁月的碎片..."
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:textColor="#A68E74" />
    </LinearLayout>

    <!-- 底部按钮 - 仅保留“重新感悟”，并使其更加含蓄优雅 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_re_generate"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="40dp"
        android:text="再次回味"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:backgroundTint="#C5A377"
        app:cornerRadius="25dp"
        app:elevation="0dp"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
