<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_chat_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/ai_chat_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI 对话"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/memory_deep_blue" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/ai_chat_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="（对话内容将在此显示）"
        android:textSize="14sp"
        android:textColor="@color/memory_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <ImageView
            android:id="@+id/ai_chat_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/close"
            android:contentDescription="关闭"
           />
    </LinearLayout>
</LinearLayout>