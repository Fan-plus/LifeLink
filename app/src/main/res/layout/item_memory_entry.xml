<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F0EDE4"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_type_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_book"
            android:padding="8dp"
            android:background="@drawable/ov_circle"
            android:backgroundTint="#FDFBF7"
            app:tint="@color/treasure_gold_muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/tv_memory_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记忆片段预览..."
                android:textSize="16sp"
                android:textColor="@color/treasure_elegant_black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_memory_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2023年10月27日 14:30"
                android:textSize="12sp"
                android:textColor="@color/memory_text_secondary"
                android:paddingTop="4dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_main"
            app:tint="#D0D0D0" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
