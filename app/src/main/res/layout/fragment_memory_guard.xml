<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eye_friendly_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1️⃣ 页面标题 -->
            <LinearLayout
                android:id="@+id/title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="16dp"
                android:paddingHorizontal="8dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_memory"
                    app:tint="@color/memory_deep_blue"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_guard_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/memory_deep_blue" />
            </LinearLayout>

            <!-- 2️⃣ 模块一：我的记忆库 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/memory_library_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_module_title"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/memory_deep_blue"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <EditText
                            android:id="@+id/memory_input"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/memory_input_bg"
                            android:paddingHorizontal="12dp"
                            android:hint="@string/memory_input_hint"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/memory_add_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/memory_add_button"
                            android:background="@drawable/memory_add_btn_bg"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/memory_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="240dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3️⃣ 模块二：智能拍照识别 (异步操作区) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/medicine_recognition_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="智能文字识别 · AI 辅助解析"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/memory_deep_blue"
                        android:layout_marginBottom="16dp" />

                    <!-- 子区①：状态显示区 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_operation_section"
                        android:padding="16dp"
                        android:layout_marginBottom="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/memory_gray_placeholder">

                            <LinearLayout
                                android:id="@+id/ocr_status_container"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">
                                <ImageView
                                    android:id="@+id/ocr_status_icon"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:src="@drawable/ic_medicine"
                                    app:tint="@color/memory_text_secondary" />
                                <TextView
                                    android:id="@+id/ocr_status_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="点击下方按钮开始识别"
                                    android:textColor="@color/memory_text_secondary"
                                    android:gravity="center"
                                    android:layout_marginTop="12dp" />
                                <ProgressBar
                                    android:id="@+id/ocr_status_progress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <Button
                            android:id="@+id/medicine_shoot_btn"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:text="📷 立即拍照 / 选择图片识别"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:background="@drawable/medicine_shoot_btn_bg"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <!-- 分隔线 -->
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFE0E0E0" android:layout_marginVertical="10dp" />

                    <!-- 子区②：AI 视频播放区 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/medicine_video_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/memory_deep_blue"
                            android:layout_marginBottom="12dp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/black"
                            android:layout_marginBottom="16dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <LinearLayout
                                    android:id="@+id/video_placeholder"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/ic_book"
                                        app:tint="#66FFFFFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="视频生成后在此显示"
                                        android:textColor="#66FFFFFF"
                                        android:layout_marginTop="8dp" />
                                </LinearLayout>

                                <VideoView
                                    android:id="@+id/video_player_view"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:visibility="gone" />

                                <ProgressBar
                                    android:id="@+id/video_loading_spinner"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone" />

                                <!-- 全屏按钮 -->
                                <ImageButton
                                    android:id="@+id/btn_full_screen"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="8dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:src="@android:drawable/ic_menu_zoom"
                                    android:visibility="gone"
                                    app:tint="@color/white" />
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <Button
                            android:id="@+id/medicine_collect"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="@string/medicine_collect"
                            android:textSize="15sp"
                            android:background="@drawable/memory_add_btn_bg"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View android:layout_width="match_parent" android:layout_height="100dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ai_chat_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_mic"
        app:backgroundTint="@color/ai_chat_button"
        app:tint="@color/white" />

</FrameLayout>
