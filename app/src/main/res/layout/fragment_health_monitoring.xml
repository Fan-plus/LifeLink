<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/health_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="88dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/health_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="健康监测"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/health_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手表已连接"
                    android:textColor="@color/status_green_background"
                    android:textSize="12sp"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Trend selector -->
            <Spinner
                android:id="@+id/trend_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:spinnerMode="dropdown"
                android:background="@drawable/spinner_bg"/>

            <!-- Overview cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="10dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/hr_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="心率"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hr_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- bpm"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="10dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/bp_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="血压"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bp_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- / -- mmHg"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="10dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/spo2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="血氧"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/spo2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/battery_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手表电量"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/battery_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Charts (collapsible) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- ECG chart card (可选，供下拉选择显示) -->
                <LinearLayout
                    android:id="@+id/ecg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="心电图"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/ecg_preview"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="8dp"
                        android:background="#f0f7ff" />
                </LinearLayout>

                <!-- Heart Rate chart card -->
                <LinearLayout
                    android:id="@+id/hr_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="心率趋势"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/hr_toggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:contentDescription="展开" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/hr_preview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp"
                        android:background="#e6f2ff">

                        <TextView
                            android:id="@+id/hr_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="心率图表不可用"
                            android:textSize="16sp"
                            android:textColor="#444444" />

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/hr_expanded"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:background="#ffffff">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#dbefff" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Blood pressure chart card -->
                <LinearLayout
                    android:id="@+id/bp_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="血压趋势"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/bp_toggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:contentDescription="展开" />
                    </LinearLayout>

                    <View
                        android:id="@+id/bp_preview"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="#fff0e6" />

                    <LinearLayout
                        android:id="@+id/bp_expanded"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:background="#ffffff">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#ffeedd" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Alerts summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/blue_border_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/alerts_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="异常预警"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/alerts_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最近无异常"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- AI report button -->
            <Button
                android:id="@+id/btn_ai_report"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="生成健康报告（AI）"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/ic_companion" />

            <!-- Simulated AI analysis and PDF download -->
            <LinearLayout
                android:id="@+id/ai_report_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/blue_border_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ai_report_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI 分析报告（模拟）"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_download_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="下载 PDF" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating SOS button fixed to bottom-right -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_sos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="紧急求救"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="#d9534f"
        app:srcCompat="@android:drawable/ic_dialog_alert"
        android:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>