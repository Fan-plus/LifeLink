<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/treasure_bg_soft">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="岁月私语"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/treasure_bronze"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="让 AI 帮您润色，定格美好时刻"
                android:textSize="14sp"
                android:textColor="@color/memory_text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/close"
            android:padding="8dp"
            android:background="@drawable/ov_circle"
            android:backgroundTint="#0A000000"
            app:tint="@color/treasure_bronze" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_input"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/layout_actions">

        <EditText
            android:id="@+id/et_memory_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="写下此时的心情..."
            android:padding="28dp"
            android:textSize="20sp"
            android:textColor="@color/treasure_elegant_black"
            android:lineSpacingExtra="10dp"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:fontFamily="serif" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_save_text">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_polish"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="✨ AI 润色"
            android:textColor="@color/treasure_gold_muted"
            app:backgroundTint="#FDFBF7"
            app:cornerRadius="26dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_ai_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 待命中..."
            android:textSize="12sp"
            android:textColor="@color/memory_text_secondary"
            android:layout_gravity="center_vertical"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_text"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:text="封 存 记 忆"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="32dp"
        app:backgroundTint="@color/treasure_gold_muted"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
